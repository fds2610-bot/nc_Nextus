{
    "name": "fds2610/nc_nexus",
    "description": "Project governance for Nextcloud",
    "type": "nextcloud-app",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "doctrine/dbal": "^4.2",
        "nextcloud/ocp": "dev-stable34",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Nexus\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Nexus\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "lint": "find lib tests appinfo -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test:unit": "phpunit --configuration phpunit.xml",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    }
}
